# Local catalog server for Project Vyasa development.
# Paths are relative to this Caddyfile (Caddy 2.6+).
# Committed registry (local-registry.json) lists vysamples only.
# For multi-publisher testing: cp local-registry.local.json.example local-registry.local.json
#
# Sibling repos (integrator paths below): vyasa-samples, muktabodha.org, sa.wikisource.org

:8080 {
	header {
		Access-Control-Allow-Origin "*"
		Access-Control-Allow-Methods "GET, POST, OPTIONS"
		Access-Control-Allow-Headers "*"
	}

	handle /registry.json {
		root * .
		try_files /local-registry.local.json /local-registry.json
		file_server
	}

	# vysamples (this repo)
	handle_path /vysamples/* {
		root * ./vysamples/dist
		file_server
	}

	# Integrator-only: other publisher dist/ trees (see local-registry.local.json.example)
	handle_path /muktabodha/* {
		root * ../muktabodha.org/muktabodha/dist
		file_server
	}

	handle_path /sa_wikisource/* {
		root * ../sa.wikisource.org/sa_wikisource/dist
		file_server
	}
}
