// IAST-stream display labels. Overrides only — baseline comes from primary via extend.
`localization { extend = "primary" }

`structure [
    "chapter" = "adhyāya",
    "verse" = "śloka"
]

`entities {
    "arjuna" = "arjuna",
    "krishna" = "kṛṣṇa",
    "dhritarashtra" = "dhṛtarāṣṭra",
    "sanjaya" = "sañjaya"
}

`actions {
    "uvaca" = "uvāca",
    "speaker" = "vaktā",
    "note" = "ṭippaṇī"
}

`facets {
    "speaker" = "Speaker"
}
